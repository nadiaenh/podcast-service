config:
  aws:region: us-west-2
  podcast-service:apiKey:
    secure: <run `pulumi config set --secret apiKey <value>` to generate>
  podcast-service:anthropicApiKey:
    secure: <run `pulumi config set --secret anthropicApiKey <value>`>
  podcast-service:elevenlabsApiKey:
    secure: <run `pulumi config set --secret elevenlabsApiKey <value>`>
  podcast-service:elevenlabsVoiceId: <run `pulumi config set elevenlabsVoiceId <value>`>
  podcast-service:voxtralApiKey:
    secure: <run `pulumi config set --secret voxtralApiKey <value>` (optional)>
  podcast-service:voxtralVoiceId: <run `pulumi config set voxtralVoiceId <value>` (optional)>
  podcast-service:ttsProvider: elevenlabs
